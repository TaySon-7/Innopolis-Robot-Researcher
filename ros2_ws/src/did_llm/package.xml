<?xml version="1.0"?>
<?xml-model href="http://download.quantumlabs.org/schemas/xmldtd/xmldtd.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>did_llm</name>
  <version>0.1.0</version>
  <description>
    LLM layer of the DID Hack agent: turns the mission and the current state
    into an ordered list of subgoals, and formulates falsifiable hypotheses.
    Runs strictly above the control loop; the agent must keep working when
    the model is unavailable.
  </description>
  <maintainer email="team@innopolis.local">DID Hack Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
