FROM ros:jazzy-ros-base-noble

# ============================================================================
# Образ слоя LLM без обращения к сети.
#
# На этой машине крупные файлы с зеркал не проходят: соединение рвётся на
# нескольких мегабайтах, поэтому apt-get update и установка Gazebo/Nav2 не
# заканчиваются. Обычный Dockerfile устанавливает пакеты из сети и является
# основным; этот вариант нужен, чтобы запустить и проверить слой LLM сейчас.
#
# RMW здесь rmw_fastrtps_cpp, а не rmw_cyclonedds_cpp: второй ставится через
# apt и в этом образе отсутствует, а базовый образ идёт с FastDDS.
#
# pydantic 2 копируется из локального venv: версия Python в базовом образе и
# на хосте совпадают (3.12), поэтому скомпилированный pydantic_core работает
# без пересборки.
# ============================================================================

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PYTHONPATH=/opt/did_llm_libs

COPY vendor/pylibs/ /opt/did_llm_libs/

WORKDIR /opt/did_ws

# Копируется только внутренний каталог пакета. Если скопировать внешний
# ros2_ws/src/did_llm как есть, то каталог без __init__.py превращается в
# namespace-пакет с тем же именем и перекрывает настоящий did_llm: импорт
# проходит, а модулей внутри нет.
COPY ros2_ws/src/did_llm/did_llm /opt/did_llm_pkg/did_llm
COPY ros2_ws/src/did_llm/config /opt/did_llm_pkg/config
# did_agent needs numpy and pyyaml; the base image has neither and they cannot
# be downloaded here.
COPY vendor/pylibs/ /opt/did_llm_libs/
COPY ros2_ws/src/did_agent /opt/did_agent_pkg/did_agent
COPY ros2_ws/src/did_judge /opt/did_judge_pkg/did_judge
COPY scripts/ /opt/did_ws/scripts

ENV PYTHONPATH=/opt/did_llm_libs:/opt/did_llm_pkg:/opt/did_agent_pkg:/opt/did_judge_pkg \
    ROS_DOMAIN_ID=30 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    TURTLEBOT3_MODEL=burger \
    LIBGL_ALWAYS_SOFTWARE=1

COPY docker/entrypoint.sh /did-entrypoint.sh
RUN chmod +x /did-entrypoint.sh

ENTRYPOINT ["/did-entrypoint.sh"]
CMD ["bash"]